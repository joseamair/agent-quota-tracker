# Auto-detect text files and normalize line endings
* text=auto

# Source code & configs (enforce LF)
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Windows scripts (enforce CRLF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
